<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="org.prauga.cloud.sdk.PROVIDER" />
        </intent>
    </queries>

    <application>
        <!-- Exported without a permission: every call checks the caller's signing certificate. -->
        <service
            android:name="org.prauga.cloud.sdk.agent.BackupAgentService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="org.prauga.cloud.sdk.AGENT" />
            </intent-filter>
        </service>

        <activity
            android:name="org.prauga.cloud.sdk.agent.TrustProviderActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="org.prauga.cloud.sdk.TRUST_PROVIDER" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
